@page "/respaldo"
@inject AppDataService DataService
@inject LocalStorageService Storage
<PageTitle>Respaldo | Apuntador</PageTitle>

<div class="page-header"><div><span class="eyebrow">SEGURIDAD LOCAL</span><h1>Respaldo de información</h1><p>Exporta una copia de tus datos o restaura un archivo anterior.</p></div></div>
<div class="backup-grid">
<section class="page-card backup-card"><div class="backup-icon">JSON</div><h2>Copia completa</h2><p>Incluye notas, actividades, categorías y configuración visual.</p><button class="btn btn-primary" @onclick="ExportJson">Descargar JSON</button></section>
<section class="page-card backup-card"><div class="backup-icon">TXT</div><h2>Notas en texto</h2><p>Genera un documento legible con todas tus notas actuales.</p><button class="btn btn-secondary" @onclick="ExportText">Descargar texto</button></section>
<section class="page-card backup-card"><div class="backup-icon">⇧</div><h2>Importar respaldo</h2><p>La importación reemplazará toda la información actual.</p><input @ref="fileInput" class="file-input" type="file" accept="application/json,.json" /><button class="btn btn-secondary" @onclick="Import">Importar JSON</button></section>
</div>
@if(!string.IsNullOrEmpty(message)){<div class="alert @(success?"success":"error")">@message</div>}
<section class="page-card privacy-box"><h2>Privacidad y funcionamiento</h2><p>Apuntador no envía información a internet. Los registros permanecen en LocalStorage dentro de este navegador. Al limpiar los datos del navegador o cambiar de dispositivo, la información se perderá si no existe una copia de seguridad.</p><div class="data-summary"><span><strong>@DataService.Data.Notes.Count</strong> notas</span><span><strong>@DataService.Data.Activities.Count</strong> actividades</span></div></section>

@code {
private ElementReference fileInput; private string message=""; private bool success;
protected override async Task OnInitializedAsync()=>await DataService.InitializeAsync();
private async Task ExportJson()=>await Storage.DownloadAsync($"apuntador-respaldo-{DateTime.Now:yyyyMMdd-HHmm}.json",DataService.CreateBackupJson(),"application/json");
private async Task ExportText()=>await Storage.DownloadAsync($"apuntador-notas-{DateTime.Now:yyyyMMdd-HHmm}.txt",DataService.CreateTextExport(),"text/plain;charset=utf-8");
private async Task Import(){try{var json=await Storage.ReadFileAsync(fileInput);var result=await DataService.ImportAsync(json);success=result.Success;message=result.Message;}catch{success=false;message="Selecciona un archivo JSON antes de importar.";}}
}
